# Supabase — https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Gizli anahtar — RLS bypass eder. Asla istemciye sızmamalı, asla commit edilmemeli.
SUPABASE_SECRET_KEY=sb_secret_...

# Davet/giriş bağlantılarının döneceği adres (üretimde kendi alan adınız)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
